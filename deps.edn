{:paths ["src" "resources"]
 :deps  {org.clojure/clojure              {:mvn/version "1.11.1"}
         ;; HTTP
         ring/ring-core                   {:mvn/version "1.11.0"}
         ring/ring-jetty-adapter          {:mvn/version "1.11.0"}
         metosin/reitit-ring              {:mvn/version "0.7.0"}
         metosin/reitit-swagger           {:mvn/version "0.7.0"}
         metosin/reitit-swagger-ui        {:mvn/version "0.7.0"}
         metosin/reitit-middleware        {:mvn/version "0.7.0"}
         fi.metosin/reitit-malli          {:mvn/version "0.7.0-alpha6"}
         metosin/muuntaja                 {:mvn/version "0.6.8"}
         metosin/malli                    {:mvn/version "0.13.0"}
         ;; DB
         org.postgresql/postgresql        {:mvn/version "42.7.3"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.909"}
         com.github.seancorfield/honeysql {:mvn/version "2.6.1126"}
         hikari-cp/hikari-cp              {:mvn/version "3.0.1"}
         ;; Migrations — correct group/artifact
         dev.weavejester/ragtime          {:mvn/version "0.9.4"}
         ;; Auth / Security
         buddy/buddy-auth                 {:mvn/version "3.0.1"}
         buddy/buddy-hashers              {:mvn/version "2.0.167"}
         buddy/buddy-sign                 {:mvn/version "3.5.351"}
         ;; Config
         aero/aero                        {:mvn/version "1.1.6"}
         ;; Logging
         org.clojure/tools.logging        {:mvn/version "1.2.4"}
         ch.qos.logback/logback-classic   {:mvn/version "1.4.14"}
         ;; Async / Events
         org.clojure/core.async           {:mvn/version "1.6.681"}
         ;; Utilities
         tick/tick                        {:mvn/version "0.7.5"}
         org.clojure/data.json            {:mvn/version "2.4.0"}
         com.taoensso/timbre              {:mvn/version "6.3.1"}}

 :aliases {:dev     {:extra-paths ["dev"]
                     :extra-deps  {nrepl/nrepl {:mvn/version "1.1.1"}}}
           :test    {:extra-paths ["test"]
                     :extra-deps  {lambdaisland/kaocha {:mvn/version "1.87.1366"}}}
           :migrate {:main-opts ["-m" "loanmanager.db.migrations"]}
           :build   {:deps       {io.github.clojure/tools.build {:git/tag "v0.9.6" :git/sha "8e78bcc"}}
                     :ns-default build}}}
