{;; "development" (default) or "production" — see core.clj's startup check,
 ;; which refuses to boot with a default JWT/DB secret when this is
 ;; "production". Set explicitly in any real deployment.
 :env      #or [#env ENV "development"]

 :server   {:port #long #or [#env PORT "8080"]}

 :database {:jdbc-url  #or [#env DATABASE_URL
                             "jdbc:postgresql://localhost:5432/loanmanager?stringtype=unspecified"]
            :username  #or [#env DB_USER "postgres"]
            :password  #or [#env DB_PASS "postgres"]
            :pool-size 10}

 :security {:jwt-secret       #or [#env JWT_SECRET "change-me-in-production-min-32-chars!!"]
            :jwt-expiry-hours 24
            :bcrypt-cost      12
            ;; Encrypts sensitive columns at rest (currently: users.mfa_secret)
            ;; — see loanmanager.security.crypto. No default: unset is fine in
            ;; dev (MFA enrollment fails loudly with a clear error instead of
            ;; silently storing plaintext), but core.clj's startup check
            ;; refuses to boot in production without it.
            :encryption-key   #or [#env ENCRYPTION_KEY nil]}

 :events   {:buffer-size 1024}

 :rate-limit {:requests-per-minute #long #or [#env RATE_LIMIT_RPM "300"]}

 ;; Local-disk KYC document storage — no cloud storage credentials are
 ;; available in this environment; see loanmanager.storage.local.
 :storage  {:upload-dir #or [#env UPLOAD_DIR "./data/uploads"]}

 ;; Unset SMTP_HOST leaves email delivery disabled (logged, not sent) —
 ;; no SMTP server is configured for local/dev use by default.
 :email    {:smtp-host #or [#env SMTP_HOST nil]
            :smtp-port #long #or [#env SMTP_PORT "587"]
            :smtp-user #or [#env SMTP_USER nil]
            :smtp-pass #or [#env SMTP_PASS nil]
            :from      #or [#env SMTP_FROM "noreply@loanmanager.local"]}

 :integrations {:mtn-momo {:webhook-secret #or [#env MTN_MOMO_WEBHOOK_SECRET nil]}
                :xero     {:enabled #or [#env XERO_ENABLED "false"]}}

 :swagger  {:title       "LoanOS API"
            :description "Bank-grade Loan Management Platform"
            :version     "1.0.0"}}
