{:server   {:port #long #or [#env PORT "8080"]}

 :database {:jdbc-url  #or [#env DATABASE_URL
                             "jdbc:postgresql://localhost:5432/loanmanager?stringtype=unspecified"]
            :username  #or [#env DB_USER "postgres"]
            :password  #or [#env DB_PASS "postgres"]
            :pool-size 10}

 :security {:jwt-secret       #or [#env JWT_SECRET "change-me-in-production-min-32-chars!!"]
            :jwt-expiry-hours 24
            :bcrypt-cost      12}

 :events   {:buffer-size 1024}

 ;; Unset SMTP_HOST leaves email delivery disabled (logged, not sent) —
 ;; no SMTP server is configured for local/dev use by default.
 :email    {:smtp-host #or [#env SMTP_HOST nil]
            :smtp-port #long #or [#env SMTP_PORT "587"]
            :smtp-user #or [#env SMTP_USER nil]
            :smtp-pass #or [#env SMTP_PASS nil]
            :from      #or [#env SMTP_FROM "noreply@loanmanager.local"]}

 :swagger  {:title       "LoanOS API"
            :description "Bank-grade Loan Management Platform"
            :version     "1.0.0"}}
